name: Check GitHub Profile

on:
  schedule:
    - cron: "0 0 * * *"

  workflow_dispatch:

permissions:
  contents: read

jobs:
  check-profile:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check GitHub profile
        env:
          USERNAME: sarikamehra5390
        run: |
          echo "Checking GitHub profile..."

          RESPONSE=$(curl -s \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/users/$USERNAME")

          REPOS=$(echo "$RESPONSE" | jq -r '.public_repos')
          FOLLOWERS=$(echo "$RESPONSE" | jq -r '.followers')
          FOLLOWING=$(echo "$RESPONSE" | jq -r '.following')

          echo "--------------------------------"
          echo "GitHub User : $USERNAME"
          echo "Repositories: $REPOS"
          echo "Followers   : $FOLLOWERS"
          echo "Following   : $FOLLOWING"
          echo "--------------------------------"

      - name: Verify README
        run: |
          if [ -f README.md ]; then
            echo "README.md found successfully."
          else
            echo "README.md not found."
            exit 1
          fi

      - name: Check for old Chandan references
        run: |
          if grep -RniE \
            "chandan|chandansahoo|readme-card-server-05r4|README-card.md" \
            README.md .github 2>/dev/null; then

            echo "WARNING: Old profile references found."
            exit 1
          else
            echo "No old Chandan references found."
          fi

      - name: Display README status
        run: |
          echo "--------------------------------"
          echo "README.md is present."
          echo "This workflow does NOT modify README.md."
          echo "--------------------------------"