name: Update GitHub Stats

on:
  schedule:
    # Run every day at midnight UTC
    - cron: "0 0 * * *"

  workflow_dispatch:

permissions:
  contents: write

jobs:
  update-readme:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Get GitHub statistics
        env:
          GH_TOKEN: ${{ github.token }}
          USERNAME: sarikamehra5390
        run: |
          echo "Fetching GitHub statistics..."

          USER_DATA=$(curl -s \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H "Accept: application/vnd.github+json" \
            "https://api.github.com/users/$USERNAME")

          REPO_COUNT=$(echo "$USER_DATA" | jq '.public_repos')
          FOLLOWERS=$(echo "$USER_DATA" | jq '.followers')

          echo "Public repositories: $REPO_COUNT"
          echo "Followers: $FOLLOWERS"

          echo "REPO_COUNT=$REPO_COUNT" >> "$GITHUB_ENV"
          echo "FOLLOWERS=$FOLLOWERS" >> "$GITHUB_ENV"

      - name: Update README placeholders
        run: |
          if grep -q "%%REPO_COUNT%%" README.md; then
            sed -i "s|%%REPO_COUNT%%|$REPO_COUNT|g" README.md
          fi

          if grep -q "%%FOLLOWERS%%" README.md; then
            sed -i "s|%%FOLLOWERS%%|$FOLLOWERS|g" README.md
          fi

      - name: Commit README changes
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"

          git add README.md

          if git diff --cached --quiet; then
            echo "No changes detected."
          else
            git commit -m "chore: update GitHub stats"
            git push
          fi